# ── LLM ──────────────────────────────────────────────────────────────────
# Gemini é gratuito (sem cartão): https://aistudio.google.com/apikey
# A cota gratuita é por CONTA GOOGLE, não por chave — então gerar várias
# chaves na mesma conta não ajuda. Se cada integrante da equipe gerar a
# própria chave (conta própria), dá pra listar todas aqui separadas por
# vírgula (GEMINI_API_KEYS) e o backend troca de chave sozinho quando uma
# esgota a cota do dia. Uma chave só também funciona (GEMINI_API_KEY).
GEMINI_API_KEYS=
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash

# ── Opcional: sobrescreve os padrões de rag_system.py ────────────────────
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=
RAG_TOP_K=5
RAG_MIN_SCORE=0.25

# ── IoT (MQTT — mesmo broker/tópico do ESP32 em iot/esp32/.env) ──────────
MQTT_SERVER=
MQTT_PORT=8883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=esp32/cardio/data

# ── Banco (conta de usuário — src/modules/auth, shared/db.py) ────────────
# Credenciais do serviço "db" do docker-compose.yml.
POSTGRES_USER=cardioia
POSTGRES_PASSWORD=
POSTGRES_DB=cardioia
# Pra rodar o backend direto da venv (fora do Docker), apontando pro
# Postgres publicado em 127.0.0.1:5432 pelo docker-compose. Dentro do
# compose, o backend sobrescreve isso pra usar "db" em vez de "localhost"
# (ver environment.DATABASE_URL no docker-compose.yml).
DATABASE_URL=postgresql+psycopg2://cardioia:SENHA_AQUI@localhost:5432/cardioia

# ── Observabilidade (shared/observabilidade.py, docker-compose.yml) ──────
# Endereço do Tempo pra onde o backend exporta traces (OTLP). Só existe
# dentro do docker-compose — sem isso, tracing fica desligado (sem erro).
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
# Senha de login do Grafana (http://localhost:3000, usuário "admin").
GRAFANA_ADMIN_PASSWORD=cardioia

# ── Servidor ─────────────────────────────────────────────────────────────
# Endereço de escuta. 127.0.0.1 = só este computador (padrão).
HOST=127.0.0.1
PORT=5000
# Origens do front que podem chamar a API, separadas por vírgula
# (8081/19006 = Expo em dev, 5173 = Vite em dev; a URL da Vercel é a do
# app/web publicado em produção).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5173,https://fase-7-coracao-sob-controle-previsao.vercel.app
